#!/bin/bash
set -e

# Resolve the repo from this script's own location, before env.sh has had a
# chance to define PROJECT_ROOT. Going the other way round means an unset
# PROJECT_ROOT sends cd to $HOME and env.sh is sourced from wherever that lands.
cd "$(dirname "${BASH_SOURCE[0]}")/.."

source env.sh

# Installs chrome into $PUPPETEER_CACHE_DIR and prints its executable path.
# Idempotent: if the browser is already there this returns the path without
# downloading, so it is cheap enough to call on every build.
install_output=$(bun run puppeteer browsers install chrome | tee /dev/stderr | tail -n 1)

# The last line is "chrome@<version> <path>"; strip the version prefix.
echo "${install_output#* }"
