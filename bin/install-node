#!/bin/bash
set -e

# Resolve the repo from this script's own location, before env.sh has had a
# chance to define PROJECT_ROOT. Going the other way round means an unset
# PROJECT_ROOT sends cd to $HOME and env.sh is sourced from wherever that lands.
cd "$(dirname "${BASH_SOURCE[0]}")/.."

source env.sh

if command -v bun &>/dev/null && [ "$(bun --version)" = "$BUN_VERSION" ]; then
	echo "bun is already installed with the correct version"
else
	echo "Installing bun"
	curl -# -fsSL https://bun.sh/install | bash -s "bun-v$BUN_VERSION"
fi

bun install

install-chrome >/dev/null
