#!/bin/bash
set -e

cd $PROJECT_ROOT

source env.sh

format

# Use the browser this project installs rather than whatever chrome happens to
# be on the machine, so the build is reproducible anywhere setup-local ran.
CHROME_PATH=$(install-chrome)
export PUPPETEER_EXECUTABLE_PATH=$CHROME_PATH

# Start the server process and store its PID
bun run server.ts &
SERVER_PID=$!

# Kill the server on exit, preserving the failing command's status so callers
# like bin/deploy don't mistake a broken build for a successful one.
cleanup() {
	status=$?
	echo 'Killing server process'
	kill -9 $SERVER_PID 2>/dev/null || true
	exit $status
}
trap cleanup EXIT

# Wait for the server to accept connections before pointing a browser at it.
for _ in $(seq 50); do
	if curl -fsS -o /dev/null http://localhost:3001; then
		break
	fi
	sleep 0.2
done
curl -fsS -o /dev/null http://localhost:3001

BROWSER_HEADLESS=true

# Every one of these flags is off for the same reason: single-file's
# optimisations strip things the resume actually needs (its scripts, its fonts,
# elements hidden at one breakpoint but shown at another). Shared verbatim
# between the two captures below, which differ only in URL and output path.
SINGLE_FILE_ARGS=(
	--browser-executable-path "$CHROME_PATH"
	--browser-headless "$BROWSER_HEADLESS"
	--block-scripts false
	--compress-HTML false
	--group-duplicate-images false
	--insert-meta-CSP false
	--load-deferred-images false
	--remove-hidden-elements false
	--remove-unused-styles false
	--remove-unused-fonts false
	--remove-alternative-fonts false
	--remove-alternative-medias false
	--remove-alternative-images false
	--self-extracting-archive false
	--extract-data-from-page false
	--insert-single-file-comment false
)

# Run the build process
rm -rf dist && mkdir dist

# Same app twice; ?pdf switches it to the print layout.
bun run single-file "${SINGLE_FILE_ARGS[@]}" http://localhost:3001 dist/index.html
bun run single-file "${SINGLE_FILE_ARGS[@]}" 'http://localhost:3001?pdf' dist/pdf.html

# Build the PDF
bun run pdf.ts

# single-file writes empty output on some failures, so make sure the deploy
# artifacts actually exist before anyone publishes them.
for artifact in dist/index.html dist/pdf.html dist/lucas_doyle_resume.pdf; do
	if [ ! -s "$artifact" ]; then
		echo "Build failed: $artifact is missing or empty" >&2
		exit 1
	fi
done

# Exit immediately without waiting for the server process
exit
