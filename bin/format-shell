#!/bin/bash
set -e

# Resolve the repo from this script's own location, before env.sh has had a
# chance to define PROJECT_ROOT. Going the other way round means an unset
# PROJECT_ROOT sends cd to $HOME and env.sh is sourced from wherever that lands.
cd "$(dirname "${BASH_SOURCE[0]}")/.."

source env.sh

files=()
bin_shell_paths=()

# List all tracked files and untracked files not ignored by .gitignore
while IFS= read -r file; do
	files+=("$file")
done < <(
	git ls-files
	git ls-files --others --exclude-standard
)

# scan everything in $files. if the file has bash in the first line, add it to bin_shell_paths
for file in "${files[@]}"; do
	if [ -f "$file" ]; then
		if head -n 1 "$file" | grep -q "bash"; then
			bin_shell_paths+=("$file")
		fi
	fi
done

shfmt -l -w "${bin_shell_paths[@]}"
